{
  "name": "conmath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A resource-aware constructive mathematics book",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && node scripts/check.mjs && npm run build && npm run test:browser",
    "inventory": "node scripts/check.mjs --json",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "marked": "18.0.13",
    "pyodide": "314.0.7"
  }
}
